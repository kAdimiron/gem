<UserControl x:Class="Gem.Views.TorrentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Gem.Localization"
             xmlns:models="clr-namespace:Gem.Models"
             xmlns:views="clr-namespace:Gem.Views"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1040">
    <UserControl.Resources>
        <ContextMenu x:Key="TorrentCardContextMenu"
                     DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <ui:MenuItem Header="{Binding StartSelectedMenuHeader}"
                         Icon="{ui:SymbolIcon Play24}"
                         IsEnabled="{Binding CanStartSelectedTorrents}"
                         Command="{Binding StartSelectedTorrentsCommand}" />
            <ui:MenuItem Header="{Binding PauseSelectedMenuHeader}"
                         Icon="{ui:SymbolIcon Pause24}"
                         Visibility="{Binding CanPauseSelectedTorrents, Converter={StaticResource BoolToVisibility}}"
                         Command="{Binding PauseSelectedTorrentsCommand}" />
            <ui:MenuItem Header="{Binding StopSelectedMenuHeader}"
                         Icon="{ui:SymbolIcon Stop24}"
                         Visibility="{Binding CanStopSelectedTorrents, Converter={StaticResource BoolToVisibility}}"
                         Command="{Binding StopSelectedTorrentsCommand}" />
            <Separator />
            <ui:MenuItem Header="{loc:Tr TorrentsMenuDetails}"
                         Icon="{ui:SymbolIcon Open24}"
                         Visibility="{Binding IsSingleTorrentSelected, Converter={StaticResource BoolToVisibility}}"
                         Command="{Binding OpenSelectedTorrentDetailsCommand}" />
            <Separator Visibility="{Binding IsSingleTorrentSelected, Converter={StaticResource BoolToVisibility}}" />
            <ui:MenuItem Header="{Binding RemoveSelectedMenuHeader}"
                         Icon="{ui:SymbolIcon Delete24}"
                         Foreground="#F16A5C"
                         IsEnabled="{Binding HasSelectedTorrents}"
                         Command="{Binding RequestRemoveSelectedTorrentsCommand}" />
        </ContextMenu>
    </UserControl.Resources>
    <Grid>
        <!-- Torrent List View (shown when details view is closed) -->
        <Grid Margin="24,18,24,18"
              Visibility="{Binding IsDetailsOpen, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <!-- Header & Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding CurrentSectionTitle}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <Border CornerRadius="10"
                        Padding="8,2"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <TextBlock Text="{Binding FilteredTorrents.Count}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Border>
                <Border CornerRadius="10"
                        Padding="9,2"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                        Visibility="{Binding HasMultipleSelectedTorrents, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="White">
                        <Run Text="{loc:Tr TorrentsSelectedCountPrefix}" />
                        <Run Text="{Binding SelectedTorrentsCount, Mode=OneWay}" />
                    </TextBlock>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ui:Button Content="{loc:Tr TorrentsAddButton}"
                           Icon="{ui:SymbolIcon Add24}"
                           Appearance="Primary"
                           Height="32"
                           Margin="0,0,8,0"
                           Command="{Binding AddTorrentFileCommand}" />
                <ui:Button Content="{loc:Tr TorrentsMagnetButton}"
                           Icon="{ui:SymbolIcon Link24}"
                           Appearance="Secondary"
                           Height="32"
                           Margin="0,0,8,0"
                           Command="{Binding OpenAddMagnetModalCommand}" />
                <ui:Button Icon="{ui:SymbolIcon Play24}"
                           ToolTip="{loc:Tr TorrentsStartAllTooltip}"
                           Height="32"
                           Width="34"
                           Padding="0"
                           Margin="0,0,6,0"
                           Command="{Binding StartAllCommand}" />
                <ui:Button Icon="{ui:SymbolIcon Pause24}"
                           ToolTip="{loc:Tr TorrentsPauseAllTooltip}"
                           Height="32"
                           Width="34"
                           Padding="0"
                           Command="{Binding PauseAllCommand}" />
            </StackPanel>
        </Grid>

        <!-- Filter Pills (visible on Downloads view) -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,14"
                    Visibility="{Binding IsDownloadsView, Converter={StaticResource BoolToVisibility}}">
            <RadioButton Content="{loc:Tr TorrentsFilterAll}"
                         GroupName="TorrentFilter"
                         IsChecked="True"
                         Style="{StaticResource FilterPillRadioStyle}"
                         Command="{Binding SetFilterCommand}"
                         CommandParameter="{x:Static models:TorrentFilterKind.All}" />
            <RadioButton Content="{loc:Tr TorrentsFilterDownloading}"
                         GroupName="TorrentFilter"
                         Style="{StaticResource FilterPillRadioStyle}"
                         Command="{Binding SetFilterCommand}"
                         CommandParameter="{x:Static models:TorrentFilterKind.Downloading}" />
            <RadioButton Content="{loc:Tr TorrentsFilterPaused}"
                         GroupName="TorrentFilter"
                         Style="{StaticResource FilterPillRadioStyle}"
                         Command="{Binding SetFilterCommand}"
                         CommandParameter="{x:Static models:TorrentFilterKind.Paused}" />
            <RadioButton Content="{loc:Tr TorrentsFilterErrors}"
                         GroupName="TorrentFilter"
                         Style="{StaticResource FilterPillRadioStyle}"
                         Command="{Binding SetFilterCommand}"
                         CommandParameter="{x:Static models:TorrentFilterKind.Errors}" />
        </StackPanel>

        <!-- Torrent Cards List -->
        <Grid Grid.Row="2">
            <ListView x:Name="TorrentsListView"
                      ItemsSource="{Binding FilteredTorrents}"
                      SelectionMode="Multiple"
                      SelectionChanged="TorrentsListView_SelectionChanged"
                      PreviewKeyDown="TorrentsListView_PreviewKeyDown"
                      PreviewMouseLeftButtonDown="TorrentsListView_PreviewMouseLeftButtonDown"
                      PreviewMouseLeftButtonUp="TorrentsListView_PreviewMouseLeftButtonUp"
                      BorderThickness="0"
                      Background="Transparent"
                      ScrollViewer.CanContentScroll="False"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,12,8" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListView}}" />
                        <Setter Property="ContextMenu" Value="{StaticResource TorrentCardContextMenu}" />
                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListViewItem_PreviewMouseRightButtonDown" />
                        <EventSetter Event="ContextMenuOpening" Handler="ListViewItem_ContextMenuOpening" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="CardBorder"
                                            CornerRadius="8"
                                            Padding="16,14"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                            <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:TorrentItemModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Status Icon Tile -->
                            <Border Grid.Column="0"
                                    Width="42"
                                    Height="42"
                                    CornerRadius="8"
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center"
                                    Background="{Binding StatusKind, Converter={StaticResource StatusBrushConverter}}">
                                <ui:SymbolIcon Symbol="ArrowDownload24"
                                               FontSize="20"
                                               Foreground="White" />
                            </Border>

                            <!-- Title, Progress, Stats -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="520"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Border CornerRadius="4"
                                            Padding="7,2"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Background="{Binding StatusKind, Converter={StaticResource StatusBrushConverter}}">
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="White" />
                                    </Border>
                                </StackPanel>

                                <ProgressBar Value="{Binding Progress, Mode=OneWay}"
                                             Maximum="100"
                                             Height="5"
                                             Margin="0,8,0,6"
                                             Foreground="{Binding StatusKind, Converter={StaticResource StatusBrushConverter}}" />

                                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="{Binding DownloadedBytes, Mode=OneWay, Converter={StaticResource BytesConverter}}" />
                                    <Run Text="{loc:Tr TorrentsOfPrefix}" />
                                    <Run Text="{Binding TotalSize, Mode=OneWay, Converter={StaticResource BytesConverter}}" />
                                    <Run Text=" (" />
                                    <Run Text="{Binding Progress, Mode=OneWay, StringFormat={}{0:0.0}%}" />
                                    <Run Text=")" />
                                    <Run Text="{loc:Tr TorrentsPeersInlinePrefix}" />
                                    <Run Text="{Binding ConnectedPeers, Mode=OneWay}" />
                                    <Run Text="{loc:Tr TorrentsSeedsInlinePrefix}" />
                                    <Run Text="{Binding TotalSeeders, Mode=OneWay}" />
                                    <Run Text="{loc:Tr TorrentsEtaInlinePrefix}" />
                                    <Run Text="{Binding Eta, Mode=OneWay, Converter={StaticResource EtaConverter}}" />
                                </TextBlock>
                            </StackPanel>

                            <!-- Live Speeds -->
                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        MinWidth="120"
                                        Margin="0,0,16,0">
                                <TextBlock HorizontalAlignment="Right"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">
                                    <Run Text="↓ " />
                                    <Run Text="{Binding DownloadSpeed, Mode=OneWay, Converter={StaticResource SpeedConverter}}" />
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Right"
                                           FontSize="12"
                                           Margin="0,3,0,0"
                                           Foreground="#109E4E">
                                    <Run Text="↑ " />
                                    <Run Text="{Binding UploadSpeed, Mode=OneWay, Converter={StaticResource SpeedConverter}}" />
                                </TextBlock>
                            </StackPanel>

                            <!-- Quick Action Buttons -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Icon="{ui:SymbolIcon Play24}"
                                           ToolTip="{loc:Tr TorrentsActionStart}"
                                           Width="34"
                                           Height="34"
                                           Padding="0"
                                           Margin="0,0,6,0"
                                           Visibility="{Binding CanStart, Converter={StaticResource BoolToVisibility}}"
                                           Command="{Binding DataContext.StartTorrentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}" />
                                <ui:Button Icon="{ui:SymbolIcon Pause24}"
                                           ToolTip="{loc:Tr TorrentsActionPause}"
                                           Width="34"
                                           Height="34"
                                           Padding="0"
                                           Margin="0,0,6,0"
                                           Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibility}}"
                                           Command="{Binding DataContext.PauseTorrentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}" />
                                <ui:Button Icon="{ui:SymbolIcon Stop24}"
                                           ToolTip="{loc:Tr TorrentsActionStop}"
                                           Width="34"
                                           Height="34"
                                           Padding="0"
                                           Margin="0,0,6,0"
                                           Visibility="{Binding CanStop, Converter={StaticResource BoolToVisibility}}"
                                           Command="{Binding DataContext.StopTorrentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}" />
                                <ui:Button Icon="{ui:SymbolIcon FolderOpen24}"
                                           ToolTip="{loc:Tr TorrentsActionOpenFolder}"
                                           Width="34"
                                           Height="34"
                                           Padding="0"
                                           Margin="0,0,6,0"
                                           Command="{Binding DataContext.OpenTorrentFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}" />
                                <ui:Button Icon="{ui:SymbolIcon Delete24}"
                                           ToolTip="{loc:Tr TorrentsActionDelete}"
                                           Width="34"
                                           Height="34"
                                           Padding="0"
                                           Command="{Binding DataContext.RequestRemoveTorrentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Empty state -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="{Binding FilteredTorrents.Count, Converter={StaticResource InverseBoolToVisibility}}">
                <ui:SymbolIcon Symbol="Folder24"
                               FontSize="44"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Tr TorrentsEmptyTitle}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,12,0,4"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{loc:Tr TorrentsEmptySubtitle}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
        </Grid>

        <!-- Full-Page Torrent Details View (opens when clicking a torrent) -->
        <views:TorrentDetailsView Visibility="{Binding IsDetailsOpen, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
