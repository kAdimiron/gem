<UserControl x:Class="Gem.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Gem.Localization"
             xmlns:converters="clr-namespace:Gem.Converters"
             xmlns:models="clr-namespace:Gem.Models"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1040">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <ScrollViewer x:Name="SettingsScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="28,22,10,28">
        <StackPanel x:Name="SettingsContentPanel"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,18,0"
                    MouseWheel="SettingsContentPanel_OnMouseWheel">
            <TextBlock Text="{loc:Tr SettingsTitle}"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,0,0,18"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <!-- Section: Downloads -->
            <TextBlock Text="{loc:Tr SettingsSectionDownloads}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Folder24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr SettingsDefaultPathTitle}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{loc:Tr SettingsDefaultPathDesc}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:TextBox Text="{Binding SettingsDownloadPath, UpdateSourceTrigger=PropertyChanged}"
                                Width="280"
                                Margin="0,0,8,0" />
                    <ui:Button Content="{loc:Tr CommonBrowse}"
                               Command="{Binding BrowseDefaultDownloadPathCommand}" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,20" Icon="{ui:SymbolIcon Play24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr SettingsAutoStartTitle}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{loc:Tr SettingsAutoStartDesc}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding SettingsAutoStart, Mode=TwoWay}" />
            </ui:CardControl>

            <!-- Section: Appearance -->
            <TextBlock Text="{loc:Tr SettingsSectionAppearance}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon WeatherMoon24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr SettingsThemeTitle}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{loc:Tr SettingsThemeDesc}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="ThemeComboBox"
                          Width="190"
                          SelectedValuePath="Tag"
                          SelectedValue="{Binding SettingsThemeMode, Mode=TwoWay}"
                          DropDownOpened="ComboBox_OnDropDownOpened"
                          MouseWheel="ComboBox_OnMouseWheel">
                    <ComboBoxItem Content="{loc:Tr SettingsThemeSystem}" Tag="{x:Static models:AppThemeMode.System}" />
                    <ComboBoxItem Content="{loc:Tr SettingsThemeDark}" Tag="{x:Static models:AppThemeMode.Dark}" />
                    <ComboBoxItem Content="{loc:Tr SettingsThemeLight}" Tag="{x:Static models:AppThemeMode.Light}" />
                </ComboBox>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Color24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr SettingsColorThemeTitle}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{loc:Tr SettingsColorThemeDesc}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Resources>
                        <Style x:Key="ColorSwatchRadioStyle" TargetType="RadioButton">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Width" Value="42" />
                            <Setter Property="Height" Value="42" />
                            <Setter Property="Margin" Value="0,0,6,0" />
                            <Setter Property="GroupName" Value="GemColorTheme" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="OuterFrame"
                                                CornerRadius="7"
                                                Padding="2"
                                                BorderThickness="2"
                                                BorderBrush="Transparent"
                                                Background="Transparent"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Border x:Name="SwatchBox"
                                                        CornerRadius="5"
                                                        Background="{TemplateBinding Background}"
                                                        BorderThickness="1"
                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                                <Border x:Name="CheckCornerBadge"
                                                        Width="15"
                                                        Height="15"
                                                        CornerRadius="0,4,0,4"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Visibility="Collapsed"
                                                        Background="{DynamicResource TextFillColorPrimaryBrush}">
                                                    <Path Width="9"
                                                          Height="9"
                                                          Stretch="Uniform"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Data="M 1,4.8 L 3.8,7.6 L 9,1.8"
                                                          Stroke="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                                          StrokeThickness="1.7"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="OuterFrame" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="OuterFrame" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <Setter TargetName="SwatchBox" Property="BorderThickness" Value="0" />
                                                <Setter TargetName="CheckCornerBadge" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>

                    <RadioButton Style="{StaticResource ColorSwatchRadioStyle}"
                                 IsChecked="{Binding IsMintColorThemeSelected, Mode=OneWay}"
                                 Command="{Binding SelectColorThemeCommand}"
                                 CommandParameter="{x:Static models:AppColorTheme.Mint}">
                        <RadioButton.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#018574" Offset="0" />
                                <GradientStop Color="#018574" Offset="0.495" />
                                <GradientStop Color="#109E4E" Offset="0.505" />
                                <GradientStop Color="#109E4E" Offset="1" />
                            </LinearGradientBrush>
                        </RadioButton.Background>
                    </RadioButton>

                    <RadioButton Style="{StaticResource ColorSwatchRadioStyle}"
                                 IsChecked="{Binding IsTomatoColorThemeSelected, Mode=OneWay}"
                                 Command="{Binding SelectColorThemeCommand}"
                                 CommandParameter="{x:Static models:AppColorTheme.Tomato}">
                        <RadioButton.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#DC3E26" Offset="0" />
                                <GradientStop Color="#DC3E26" Offset="0.495" />
                                <GradientStop Color="#EA7317" Offset="0.505" />
                                <GradientStop Color="#EA7317" Offset="1" />
                            </LinearGradientBrush>
                        </RadioButton.Background>
                    </RadioButton>

                    <RadioButton Style="{StaticResource ColorSwatchRadioStyle}"
                                 IsChecked="{Binding IsPurpleColorThemeSelected, Mode=OneWay}"
                                 Command="{Binding SelectColorThemeCommand}"
                                 CommandParameter="{x:Static models:AppColorTheme.Purple}">
                        <RadioButton.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#7C3AED" Offset="0" />
                                <GradientStop Color="#7C3AED" Offset="0.495" />
                                <GradientStop Color="#5B21B6" Offset="0.505" />
                                <GradientStop Color="#5B21B6" Offset="1" />
                            </LinearGradientBrush>
                        </RadioButton.Background>
                    </RadioButton>

                    <RadioButton Style="{StaticResource ColorSwatchRadioStyle}"
                                 Margin="0"
                                 IsChecked="{Binding IsSkyColorThemeSelected, Mode=OneWay}"
                                 Command="{Binding SelectColorThemeCommand}"
                                 CommandParameter="{x:Static models:AppColorTheme.Sky}">
                        <RadioButton.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#8DBCD8" Offset="0" />
                                <GradientStop Color="#8DBCD8" Offset="0.495" />
                                <GradientStop Color="#1D6F96" Offset="0.505" />
                                <GradientStop Color="#1D6F96" Offset="1" />
                            </LinearGradientBrush>
                        </RadioButton.Background>
                    </RadioButton>
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Globe24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr SettingsLanguageTitle}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{loc:Tr SettingsLanguageDesc}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="LanguageComboBox"
                          Width="250"
                          MaxDropDownHeight="360"
                          ItemsSource="{Binding AvailableLanguages}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Code"
                          SelectedValue="{Binding SettingsLanguage, Mode=TwoWay}"
                          DropDownOpened="ComboBox_OnDropDownOpened"
                          MouseWheel="ComboBox_OnMouseWheel" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Window24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr SettingsMinimizeToTrayTitle}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{loc:Tr SettingsMinimizeToTrayDesc}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding SettingsMinimizeToTrayOnClose, Mode=TwoWay}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,20" Icon="{ui:SymbolIcon Power24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr SettingsLaunchAtStartupTitle}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{loc:Tr SettingsLaunchAtStartupDesc}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding SettingsLaunchAtStartup, Mode=TwoWay}" />
            </ui:CardControl>

            <!-- Section: Network & Protocol -->
            <TextBlock Text="{loc:Tr SettingsSectionNetwork}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Globe24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr SettingsListenPortTitle}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{loc:Tr SettingsListenPortDesc}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:NumberBox Value="{Binding SettingsListenPort, Mode=TwoWay}"
                              Minimum="1024"
                              Maximum="65535"
                              SpinButtonPlacementMode="Compact"
                              Width="140" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Share24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr SettingsDhtTitle}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{loc:Tr SettingsDhtDesc}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding SettingsEnableDht, Mode=TwoWay}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon People24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr SettingsLpdTitle}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{loc:Tr SettingsLpdDesc}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding SettingsEnableLpd, Mode=TwoWay}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon ArrowSync24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr SettingsUpnpTitle}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{loc:Tr SettingsUpnpDesc}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding SettingsEnablePortForwarding, Mode=TwoWay}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon ArrowUpload24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr SettingsSeedAfterDownloadTitle}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{loc:Tr SettingsSeedAfterDownloadDesc}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding SettingsSeedAfterDownload, Mode=TwoWay}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon ArrowSync24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr SettingsReannounceTitle}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{loc:Tr SettingsReannounceDesc}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:NumberBox Value="{Binding SettingsReannounceIntervalSeconds, Mode=TwoWay}"
                              Minimum="0"
                              Maximum="86400"
                              SpinButtonPlacementMode="Compact"
                              Width="150" />
            </ui:CardControl>

            <Border Margin="0,0,0,20"
                    Padding="16"
                    CornerRadius="6"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ui:SymbolIcon Symbol="Link24" FontSize="18" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{loc:Tr SettingsDefaultTrackersTitle}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{loc:Tr SettingsDefaultTrackersDesc}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox Text="{Binding SettingsDefaultTrackersText, UpdateSourceTrigger=PropertyChanged}"
                                AcceptsReturn="True"
                                VerticalScrollBarVisibility="Auto"
                                MinHeight="104"
                                MaxHeight="180"
                                VerticalContentAlignment="Top"
                                FontFamily="Consolas"
                                FontSize="12"
                                PlaceholderText="udp://tracker.opentrackr.org:1337/announce&#x0a;udp://open.stealth.si:80/announce" />
                </StackPanel>
            </Border>

            <!-- Section: Bandwidth -->
            <TextBlock Text="{loc:Tr SettingsSectionBandwidth}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon ArrowDownload24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr SettingsMaxDownTitle}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{loc:Tr SettingsSpeedZeroHint}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:NumberBox Value="{Binding SettingsMaxDownloadKBps, Mode=TwoWay}"
                              Minimum="0"
                              Maximum="1000000"
                              SpinButtonPlacementMode="Compact"
                              Width="150" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon ArrowUpload24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr SettingsMaxUpTitle}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{loc:Tr SettingsSpeedZeroHint}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:NumberBox Value="{Binding SettingsMaxUploadKBps, Mode=TwoWay}"
                              Minimum="0"
                              Maximum="1000000"
                              SpinButtonPlacementMode="Compact"
                              Width="150" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,20" Icon="{ui:SymbolIcon Pulse24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr SettingsMaxConnTitle}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{loc:Tr SettingsMaxConnDesc}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:NumberBox Value="{Binding SettingsMaxConnections, Mode=TwoWay}"
                              Minimum="10"
                              Maximum="2000"
                              SpinButtonPlacementMode="Compact"
                              Width="150" />
            </ui:CardControl>

            <!-- Section: Updates (GitHub Releases) -->
            <TextBlock Text="{loc:Tr SettingsSectionUpdates}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <Border Margin="0,0,0,8"
                    Padding="16"
                    CornerRadius="6"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="18" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Gem " FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CurrentVersionText}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding UpdateStatusText}"
                                       FontSize="12"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ui:Button Grid.Column="1"
                                   Content="{loc:Tr SettingsCheckUpdatesButton}"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Appearance="Secondary"
                                   VerticalAlignment="Center"
                                   Command="{Binding CheckForUpdatesCommand}" />
                    </Grid>

                    <!-- Available release details -->
                    <Border Margin="0,12,0,0"
                            Padding="12"
                            CornerRadius="6"
                            Background="{DynamicResource LayerFillColorAltBrush}"
                            BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                            BorderThickness="1"
                            Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{Binding AvailableUpdate.Title}"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding AvailableUpdate.TagName}"
                                           HorizontalAlignment="Right"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            </Grid>

                            <TextBlock Text="{Binding AvailableUpdate.ReleaseNotes}"
                                       FontSize="12"
                                       MaxHeight="110"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,6,0,10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                            <ProgressBar Value="{Binding UpdateDownloadProgress, Mode=OneWay}"
                                         Maximum="100"
                                         Height="6"
                                         Margin="0,0,0,10"
                                         Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVisibility}}" />

                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="{loc:Tr SettingsDownloadInstallButton}"
                                           Icon="{ui:SymbolIcon ArrowDownload24}"
                                           Appearance="Primary"
                                           Margin="0,0,8,0"
                                           Command="{Binding DownloadAndInstallUpdateCommand}" />
                                <ui:Button Content="{loc:Tr SettingsOpenGitHubButton}"
                                           Icon="{ui:SymbolIcon Open24}"
                                           Appearance="Secondary"
                                           Command="{Binding OpenUpdateReleasePageCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Globe24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr SettingsRepoTitle}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{loc:Tr SettingsRepoDesc}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:TextBox Text="{Binding SettingsUpdateRepository, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{loc:Tr SettingsRepoPlaceholder}"
                            Width="270" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,22" Icon="{ui:SymbolIcon CheckmarkCircle24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr SettingsAutoUpdateTitle}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{loc:Tr SettingsAutoUpdateDesc}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding SettingsAutoCheckUpdates, Mode=TwoWay}" />
            </ui:CardControl>

            <!-- Save Button -->
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="{loc:Tr SettingsSaveApplyButton}"
                           Icon="{ui:SymbolIcon CheckmarkCircle24}"
                           Appearance="Primary"
                           Height="38"
                           Padding="20,0"
                           Command="{Binding SaveSettingsCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
