<UserControl x:Class="Gem.Views.TorrentDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Gem.Controls"
             xmlns:loc="clr-namespace:Gem.Localization"
             xmlns:models="clr-namespace:Gem.Models"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1120">
    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Back + Action Buttons Row -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
                <ui:Button Content="{loc:Tr CommonBack}"
                           Icon="{ui:SymbolIcon ArrowLeft24}"
                           Appearance="Secondary"
                           Height="32"
                           Padding="12,0"
                           HorizontalAlignment="Left"
                           Command="{Binding CloseDetailsCommand}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="{loc:Tr TorrentsActionStart}"
                               Icon="{ui:SymbolIcon Play24}"
                               Appearance="Primary"
                               Height="32"
                               Padding="12,0"
                               Margin="0,0,8,0"
                               Visibility="{Binding SelectedTorrent.CanStart, Converter={StaticResource BoolToVisibility}}"
                               Command="{Binding StartTorrentCommand}"
                               CommandParameter="{Binding SelectedTorrent}" />

                    <ui:Button Content="{loc:Tr TorrentsActionPause}"
                               Icon="{ui:SymbolIcon Pause24}"
                               Appearance="Secondary"
                               Height="32"
                               Padding="12,0"
                               Margin="0,0,8,0"
                               Visibility="{Binding SelectedTorrent.CanPause, Converter={StaticResource BoolToVisibility}}"
                               Command="{Binding PauseTorrentCommand}"
                               CommandParameter="{Binding SelectedTorrent}" />

                    <ui:Button Content="{loc:Tr TorrentsActionStop}"
                               Icon="{ui:SymbolIcon Stop24}"
                               Appearance="Secondary"
                               Height="32"
                               Padding="12,0"
                               Margin="0,0,8,0"
                               Visibility="{Binding SelectedTorrent.CanStop, Converter={StaticResource BoolToVisibility}}"
                               Command="{Binding StopTorrentCommand}"
                               CommandParameter="{Binding SelectedTorrent}" />

                    <ui:Button Content="{loc:Tr DetailsReannounceButton}"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Appearance="Secondary"
                               Height="32"
                               Padding="12,0"
                               Margin="0,0,8,0"
                               Command="{Binding ReannounceTorrentCommand}"
                               CommandParameter="{Binding SelectedTorrent}" />

                    <ui:Button Content="{loc:Tr DetailsRecheckButton}"
                               Icon="{ui:SymbolIcon ShieldCheckmark24}"
                               Appearance="Secondary"
                               Height="32"
                               Padding="12,0"
                               Margin="0,0,8,0"
                               Command="{Binding ForceRecheckCommand}"
                               CommandParameter="{Binding SelectedTorrent}" />

                    <ui:Button Content="{loc:Tr DetailsMagnetButton}"
                               Icon="{ui:SymbolIcon Copy24}"
                               Appearance="Secondary"
                               Height="32"
                               Padding="12,0"
                               Margin="0,0,8,0"
                               Command="{Binding CopyMagnetLinkCommand}"
                               CommandParameter="{Binding SelectedTorrent}" />

                    <ui:Button Content="{loc:Tr DetailsDeleteButton}"
                               Icon="{ui:SymbolIcon Delete24}"
                               Appearance="Secondary"
                               Height="32"
                               Padding="12,0"
                               Margin="0,0,8,0"
                               Command="{Binding RequestRemoveTorrentCommand}"
                               CommandParameter="{Binding SelectedTorrent}" />

                    <ui:Button Content="{loc:Tr DetailsOpenFolderButton}"
                               Icon="{ui:SymbolIcon FolderOpen24}"
                               Appearance="Secondary"
                               Height="32"
                               Padding="12,0"
                               Command="{Binding OpenTorrentFolderCommand}"
                               CommandParameter="{Binding SelectedTorrent}" />
                </StackPanel>
            </Grid>

            <!-- Main Details Outer Card -->
            <Border Grid.Row="1"
                    CornerRadius="10"
                    Padding="18"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1.15*" MinHeight="160" />
                        <RowDefinition Height="1*" MinHeight="140" />
                    </Grid.RowDefinitions>

                    <!-- Title + Status Summary -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="{Binding SelectedTorrent.Name}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock FontSize="12.5"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="{Binding SelectedTorrent.StatusText, Mode=OneWay}" />
                            <Run Text=" " />
                            <Run Text="{Binding SelectedTorrent.Progress, Mode=OneWay, StringFormat={}{0:0.0}%}" />
                            <Run Text=" (×" />
                            <Run Text="{Binding SelectedTorrent.Ratio, Mode=OneWay, StringFormat={}{0:0.00}}" />
                            <Run Text=")  •  " />
                            <Run Text="{Binding SelectedTorrent.SavePath, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <!-- 4 KPI Cards -->
                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
                        <!-- Peers & Seeds -->
                        <Border CornerRadius="8"
                                Padding="14,12"
                                Margin="0,0,10,0"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr DetailsCardPeersHeader}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,3"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                    <Run Text="{Binding SelectedTorrent.ConnectedPeers, Mode=OneWay}" />
                                    <Run Text="{loc:Tr DetailsPeersCountSuffix}" />
                                </TextBlock>
                                <TextBlock FontSize="11.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="{loc:Tr DetailsSeedsPrefix}" />
                                    <Run Text="{Binding SelectedTorrent.TotalSeeders, Mode=OneWay}" />
                                    <Run Text="{loc:Tr DetailsLeechersPrefix}" />
                                    <Run Text="{Binding SelectedTorrent.TotalLeechers, Mode=OneWay}" />
                                    <Run Text="{loc:Tr DetailsSwarmPrefix}" />
                                    <Run Text="{Binding SelectedTorrent.SwarmTotalPeers, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Speed -->
                        <Border CornerRadius="8"
                                Padding="14,12"
                                Margin="3,0,7,0"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr DetailsCardSpeedHeader}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,3"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                    <Run Text="↓ " />
                                    <Run Text="{Binding SelectedTorrent.DownloadSpeed, Mode=OneWay, Converter={StaticResource SpeedConverter}}" />
                                </TextBlock>
                                <TextBlock FontSize="11.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="↑ " />
                                    <Run Text="{Binding SelectedTorrent.UploadSpeed, Mode=OneWay, Converter={StaticResource SpeedConverter}}" />
                                    <Run Text="{loc:Tr DetailsUploadedPrefix}" />
                                    <Run Text="{Binding SelectedTorrent.UploadedBytes, Mode=OneWay, Converter={StaticResource BytesConverter}}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Pieces -->
                        <Border CornerRadius="8"
                                Padding="14,12"
                                Margin="7,0,3,0"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr DetailsCardPiecesHeader}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,3"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                    <Run Text="{Binding SelectedTorrent.CompletedPieces, Mode=OneWay}" />
                                    <Run Text=" / " />
                                    <Run Text="{Binding SelectedTorrent.PieceCount, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock FontSize="11.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="{loc:Tr DetailsPieceSizePrefix}" />
                                    <Run Text="{Binding SelectedTorrent.PieceLength, Mode=OneWay, Converter={StaticResource BytesConverter}}" />
                                    <Run Text="{loc:Tr DetailsHashFailsPrefix}" />
                                    <Run Text="{Binding SelectedTorrent.HashFails, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Files -->
                        <Border CornerRadius="8"
                                Padding="14,12"
                                Margin="10,0,0,0"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr DetailsCardFilesHeader}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,3"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                    <Run Text="{Binding SelectedTorrent.Files.Count, Mode=OneWay}" />
                                    <Run Text="{loc:Tr DetailsFilesCountSuffix}" />
                                </TextBlock>
                                <TextBlock FontSize="11.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="{Binding SelectedTorrent.DownloadedBytes, Mode=OneWay, Converter={StaticResource BytesConverter}}" />
                                    <Run Text=" / " />
                                    <Run Text="{Binding SelectedTorrent.TotalSize, Mode=OneWay, Converter={StaticResource BytesConverter}}" />
                                    <Run Text=" (" />
                                    <Run Text="{Binding SelectedTorrent.Progress, Mode=OneWay, StringFormat={}{0:0.0}%}" />
                                    <Run Text=")" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Middle Row: Piece Map + Files -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Piece Map Card -->
                        <Border Grid.Column="0"
                                CornerRadius="8"
                                Padding="14"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock FontSize="12.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                        <Run Text="{loc:Tr DetailsPieceMapPrefix}" />
                                        <Run Text="{Binding SelectedTorrent.CompletedPieces, Mode=OneWay}" />
                                        <Run Text="{loc:Tr TorrentsOfPrefix}" />
                                        <Run Text="{Binding SelectedTorrent.PieceCount, Mode=OneWay}" />
                                        <Run Text="{loc:Tr DetailsPieceMapSizeMid}" />
                                        <Run Text="{Binding SelectedTorrent.PieceLength, Mode=OneWay, Converter={StaticResource BytesConverter}}" />
                                        <Run Text=")" />
                                    </TextBlock>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel.Resources>
                                            <Style x:Key="PieceLegendAccentSquareStyle" TargetType="Border">
                                                <Setter Property="Width" Value="8" />
                                                <Setter Property="Height" Value="8" />
                                                <Setter Property="CornerRadius" Value="1.5" />
                                                <Setter Property="Margin" Value="1,0" />
                                                <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTorrent.StatusKind}" Value="{x:Static models:TorrentStatusKind.Seeding}">
                                                        <Setter Property="Background" Value="{DynamicResource GemSeedingBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Resources>
                                        <TextBlock Text="0%" FontSize="10.5" Margin="0,0,5,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <Border Width="8" Height="8" CornerRadius="1.5" Margin="1,0" Background="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                        <Border Opacity="0.35" Style="{StaticResource PieceLegendAccentSquareStyle}" />
                                        <Border Opacity="0.65" Style="{StaticResource PieceLegendAccentSquareStyle}" />
                                        <Border Style="{StaticResource PieceLegendAccentSquareStyle}" />
                                        <TextBlock Text="100%" FontSize="10.5" Margin="5,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Grid>

                                <controls:PieceMapControl Grid.Row="1"
                                                          Pieces="{Binding SelectedTorrent.PieceBucketFill}"
                                                          UploadingPieces="{Binding SelectedTorrent.UploadingPieces}"
                                                          TotalPieces="{Binding SelectedTorrent.PieceCount}">
                                    <controls:PieceMapControl.Style>
                                        <Style TargetType="controls:PieceMapControl">
                                            <Setter Property="IsSeeding" Value="False" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTorrent.StatusKind}" Value="{x:Static models:TorrentStatusKind.Seeding}">
                                                    <Setter Property="IsSeeding" Value="True" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:PieceMapControl.Style>
                                </controls:PieceMapControl>
                            </Grid>
                        </Border>

                        <!-- Files Card -->
                        <Border Grid.Column="2"
                                CornerRadius="8"
                                Padding="14,14,4,14"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,10,10">
                                    <TextBlock FontSize="12.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                        <Run Text="{loc:Tr DetailsFilesPrefix}" />
                                        <Run Text="{Binding SelectedTorrent.Files.Count, Mode=OneWay}" />
                                        <Run Text=")" />
                                    </TextBlock>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ui:Button Content="{loc:Tr DetailsSelectAllFiles}"
                                                   Appearance="Secondary"
                                                   Height="24"
                                                   Padding="10,0"
                                                   FontSize="11"
                                                   Margin="0,0,6,0"
                                                   Command="{Binding SelectAllFilesCommand}" />
                                        <ui:Button Content="{loc:Tr DetailsDeselectAllFiles}"
                                                   Appearance="Secondary"
                                                   Height="24"
                                                   Padding="10,0"
                                                   FontSize="11"
                                                   Command="{Binding DeselectAllFilesCommand}" />
                                    </StackPanel>
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SelectedTorrent.Files}" Margin="0,0,12,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:TorrentFileModel}">
                                                <Border CornerRadius="6"
                                                        Padding="10,8"
                                                        Margin="0,0,0,6"
                                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox Grid.Column="0"
                                                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                                  Click="FileCheckBox_Click"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,10,0" />

                                                        <StackPanel Grid.Column="1">
                                                            <Grid>
                                                                <TextBlock Text="{Binding RelativePath}"
                                                                           FontSize="12.5"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Margin="0,0,60,0"
                                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                <TextBlock Text="{Binding Progress, StringFormat={}{0:0.0}%}"
                                                                           FontSize="11.5"
                                                                           HorizontalAlignment="Right"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            </Grid>

                                                            <ProgressBar Value="{Binding Progress, Mode=OneWay}"
                                                                         Maximum="100"
                                                                         Height="4"
                                                                         Margin="0,6,0,4" />

                                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                                <Run Text="{Binding BytesDownloaded, Mode=OneWay, Converter={StaticResource BytesConverter}}" />
                                                                <Run Text=" / " />
                                                                <Run Text="{Binding Length, Mode=OneWay, Converter={StaticResource BytesConverter}}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Bottom Row: Connected Peers + Trackers -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Connected Peers Card -->
                        <Border Grid.Column="0"
                                CornerRadius="8"
                                Padding="14,14,4,14"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Margin="0,0,10,10"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                    <Run Text="{loc:Tr DetailsPeersPrefix}" />
                                    <Run Text="{Binding SelectedTorrent.Peers.Count, Mode=OneWay}" />
                                    <Run Text=")" />
                                </TextBlock>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SelectedTorrent.Peers}" Margin="0,0,12,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:TorrentPeerModel}">
                                                <Border CornerRadius="6"
                                                        Padding="10,8"
                                                        Margin="0,0,0,6"
                                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <Grid Grid.Row="0">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border CornerRadius="4"
                                                                        Padding="6,1"
                                                                        Margin="0,0,8,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSeeder}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource GemSeedingBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding RoleBadge}"
                                                                               FontSize="10"
                                                                               FontWeight="SemiBold">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsSeeder}" Value="True">
                                                                                        <Setter Property="Foreground" Value="White" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                                <TextBlock Text="{Binding Endpoint}"
                                                                           FontSize="12.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            </StackPanel>

                                                            <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:0.0}%}"
                                                                       FontSize="11.5"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </Grid>

                                                        <Grid Grid.Row="1" Margin="0,4,0,0">
                                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                                <Run Text="{Binding ClientName, Mode=OneWay}" />
                                                                <Run Text=" • " />
                                                                <Run Text="{Binding DirectionRu, Mode=OneWay}" />
                                                            </TextBlock>

                                                            <TextBlock FontSize="11"
                                                                       HorizontalAlignment="Right"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                                <Run Text="↓ " />
                                                                <Run Text="{Binding DownloadSpeed, Mode=OneWay, Converter={StaticResource SpeedConverter}}" />
                                                                <Run Text="  ↑ " />
                                                                <Run Text="{Binding UploadSpeed, Mode=OneWay, Converter={StaticResource SpeedConverter}}" />
                                                            </TextBlock>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock Grid.Row="1"
                                           Text="{loc:Tr DetailsNoPeers}"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Visibility="{Binding SelectedTorrent.Peers.Count, Converter={StaticResource InverseBoolToVisibility}}" />
                            </Grid>
                        </Border>

                        <!-- Trackers Card -->
                        <Border Grid.Column="2"
                                CornerRadius="8"
                                Padding="14,14,4,14"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,10,10">
                                    <TextBlock FontSize="12.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                        <Run Text="{loc:Tr DetailsTrackersPrefix}" />
                                        <Run Text="{Binding SelectedTorrent.Trackers.Count, Mode=OneWay}" />
                                        <Run Text=")" />
                                    </TextBlock>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <ui:TextBox Width="230"
                                                    Height="26"
                                                    Padding="8,2"
                                                    FontSize="11.5"
                                                    PlaceholderText="{loc:Tr DetailsTrackerPlaceholder}"
                                                    Text="{Binding NewTrackerInputText, UpdateSourceTrigger=PropertyChanged}">
                                            <ui:TextBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding AddTrackerToSelectedCommand}" />
                                            </ui:TextBox.InputBindings>
                                        </ui:TextBox>
                                        <ui:Button Icon="{ui:SymbolIcon Add24}"
                                                   ToolTip="{loc:Tr DetailsAddTrackerTooltip}"
                                                   Appearance="Secondary"
                                                   Height="26"
                                                   Width="28"
                                                   Padding="0"
                                                   Margin="6,0,0,0"
                                                   Command="{Binding AddTrackerToSelectedCommand}" />
                                    </StackPanel>
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SelectedTorrent.Trackers}" Margin="0,0,12,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:TorrentTrackerModel}">
                                                <Border CornerRadius="6"
                                                        Padding="10,8"
                                                        Margin="0,0,0,6"
                                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0"
                                                                    CornerRadius="4"
                                                                    Padding="7,2"
                                                                    Margin="0,0,8,0"
                                                                    VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#337A7A7A" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                                                                                <Setter Property="Background" Value="#2A109E4E" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                                <Setter Property="Background" Value="#2AC42B1C" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding StatusLabel}"
                                                                           FontSize="10.5"
                                                                           FontWeight="SemiBold"
                                                                           VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                                                                                    <Setter Property="Foreground" Value="#3CCB7F" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                                    <Setter Property="Foreground" Value="#F16A5C" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Uri}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                <TextBlock Text="{Binding TierDisplay}"
                                                                           FontSize="11"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                <ui:Button Icon="{ui:SymbolIcon Delete24}"
                                                                           ToolTip="{loc:Tr DetailsRemoveTrackerTooltip}"
                                                                           Appearance="Transparent"
                                                                           Height="24"
                                                                           Width="24"
                                                                           Padding="0"
                                                                           Margin="6,0,0,0"
                                                                           Command="{Binding DataContext.RemoveTrackerFromSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                           CommandParameter="{Binding Uri}" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <TextBlock Grid.Row="1"
                                                                   Text="{Binding DetailsLine}"
                                                                   FontSize="11"
                                                                   Margin="0,4,0,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
    </Grid>
</UserControl>
