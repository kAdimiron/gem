<UserControl x:Class="Gem.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Gem.Controls"
             xmlns:loc="clr-namespace:Gem.Localization"
             xmlns:models="clr-namespace:Gem.Models"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1040">
    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.1*" MinHeight="210" />
            <RowDefinition Height="1*" MinHeight="190" />
        </Grid.RowDefinitions>

        <!-- Row 0: 4 KPI Stat Cards -->
        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,14">
            <Border CornerRadius="8"
                    Margin="0,0,10,0"
                    Padding="16"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr HomeDownloadCardTitle}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding TotalDownloadSpeed, Converter={StaticResource SpeedConverter}}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="20" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                    </Border>
                </Grid>
            </Border>

            <Border CornerRadius="8"
                    Margin="5,0,5,0"
                    Padding="16"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr HomeUploadCardTitle}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding TotalUploadSpeed, Converter={StaticResource SpeedConverter}}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="8" Background="#1A107C10" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="20" Foreground="#109E4E" />
                    </Border>
                </Grid>
            </Border>

            <Border CornerRadius="8"
                    Margin="5,0,5,0"
                    Padding="16"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr HomeActiveCardTitle}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <Run Text="{Binding DownloadingCount, Mode=OneWay}" />
                            <Run Text=" / " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Run Text="{Binding SeedingCount, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="8" Background="#1A8764B8" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Pulse24" FontSize="20" Foreground="#8764B8" />
                    </Border>
                </Grid>
            </Border>

            <Border CornerRadius="8"
                    Margin="10,0,0,0"
                    Padding="16"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr HomeDhtCardTitle}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding DhtNodesCount}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="8" Background="#1A038387" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Globe24" FontSize="20" Foreground="#038387" />
                    </Border>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Row 1: Speed Chart (left) + Recent Torrents (right) -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Live Speed Graph Card -->
            <Border Grid.Column="0"
                    CornerRadius="8"
                    Padding="18,14"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="DataTrending24"
                                           FontSize="18"
                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                           Margin="0,0,8,0" />
                            <TextBlock Text="{loc:Tr HomeSpeedGraphTitle}"
                                       FontSize="14.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="{loc:Tr HomeLegendDownload}" FontSize="12" Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Ellipse Width="9" Height="9" Fill="#109E4E" Margin="0,0,6,0" />
                            <TextBlock Text="{loc:Tr HomeLegendUpload}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <controls:SpeedChartControl x:Name="SpeedChart" Grid.Row="1" />
                </Grid>
            </Border>

            <!-- Recent Torrents Card (Right of Speed Chart) -->
            <Border Grid.Column="2"
                    CornerRadius="8"
                    Padding="16,14,4,14"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,12,10">
                        <TextBlock Text="{loc:Tr HomeRecentTorrentsTitle}"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <ui:Button Content="{loc:Tr HomeShowAllButton}"
                                   Appearance="Transparent"
                                   HorizontalAlignment="Right"
                                   Padding="10,4"
                                   FontSize="12"
                                   Command="{Binding NavigateToCommand}"
                                   CommandParameter="{x:Static models:StoreNavSection.Downloads}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RecentTorrents}" Margin="0,0,12,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:TorrentItemModel}">
                                    <Border CornerRadius="6"
                                            Padding="12,10"
                                            Margin="0,0,0,8"
                                            Cursor="Hand"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.OpenTorrentDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <Border Grid.Column="1"
                                                        CornerRadius="4"
                                                        Padding="7,2"
                                                        Margin="8,0,0,0"
                                                        Background="{Binding StatusKind, Converter={StaticResource StatusBrushConverter}}">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="White" />
                                                </Border>
                                            </Grid>

                                            <ProgressBar Grid.Row="1"
                                                         Value="{Binding Progress, Mode=OneWay}"
                                                         Maximum="100"
                                                         Height="4"
                                                         Margin="0,8,0,6"
                                                         Foreground="{Binding StatusKind, Converter={StaticResource StatusBrushConverter}}" />

                                            <Grid Grid.Row="2">
                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                    <Run Text="{Binding DownloadedBytes, Mode=OneWay, Converter={StaticResource BytesConverter}}" />
                                                    <Run Text=" / " />
                                                    <Run Text="{Binding TotalSize, Mode=OneWay, Converter={StaticResource BytesConverter}}" />
                                                    <Run Text=" • " />
                                                    <Run Text="{Binding Progress, Mode=OneWay, StringFormat={}{0:0.0}%}" />
                                                </TextBlock>

                                                <TextBlock HorizontalAlignment="Right"
                                                           FontSize="11"
                                                           Text="{Binding PrimarySpeedDisplay, Mode=OneWay}"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty hint if no active/recent torrents -->
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding RecentTorrents.Count, Converter={StaticResource InverseBoolToVisibility}}">
                        <ui:SymbolIcon Symbol="AppStore24"
                                       FontSize="32"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:Tr HomeEmptyTitle}"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,2"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{loc:Tr HomeEmptySubtitle}"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 2: All-Time Downloaded & Uploaded Data Chart -->
        <Border Grid.Row="2"
                CornerRadius="8"
                Padding="18,14"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowSync24"
                                       FontSize="18"
                                       Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                       Margin="0,0,8,0" />
                        <TextBlock Text="{loc:Tr HomeTrafficChartTitle}"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,6,0" />
                        <TextBlock FontSize="12" Margin="0,0,16,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="{loc:Tr HomeDownloadedLabel}" />
                            <Run Text="{Binding AllTimeDownloadedBytes, Mode=OneWay, Converter={StaticResource BytesConverter}}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </TextBlock>

                        <Ellipse Width="9" Height="9" Fill="#109E4E" Margin="0,0,6,0" />
                        <TextBlock FontSize="12" Margin="0,0,16,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="{loc:Tr HomeUploadedLabel}" />
                            <Run Text="{Binding AllTimeUploadedBytes, Mode=OneWay, Converter={StaticResource BytesConverter}}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </TextBlock>

                        <Border CornerRadius="4"
                                Padding="8,2"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Run Text="{loc:Tr HomeRatioLabel}" />
                                <Run Text="{Binding AllTimeRatio, Mode=OneWay, StringFormat={}{0:0.00}}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>

                <controls:TrafficChartControl x:Name="TrafficChart" Grid.Row="1" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
