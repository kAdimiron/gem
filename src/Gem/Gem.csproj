<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Gem</AssemblyName>
    <AssemblyTitle>Gem</AssemblyTitle>
    <Product>Gem</Product>
    <Version>1.0.1</Version>
    <ApplicationIcon>Assets\Gem.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Gem.ico" />
    <Resource Include="Assets\Gem.png" />
    <EmbeddedResource Include="Localization\Locales\*.json" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gem.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="TorrentSharp.Wrap" Version="4.0.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <Target Name="OverrideNativeLibtorrent12OnBuild" AfterTargets="Build">
    <PropertyGroup>
      <_CustomTswDll>$(MSBuildThisFileDirectory)..\..\native\win-x64\tsw.dll</_CustomTswDll>
    </PropertyGroup>
    <MakeDir Directories="$(TargetDir)runtimes\win-x64\native" Condition="Exists('$(_CustomTswDll)')" />
    <Copy SourceFiles="$(_CustomTswDll)" DestinationFiles="$(TargetDir)runtimes\win-x64\native\tsw.dll" SkipUnchangedFiles="true" Condition="Exists('$(_CustomTswDll)')" />
    <Copy SourceFiles="$(_CustomTswDll)" DestinationFiles="$(TargetDir)tsw.dll" SkipUnchangedFiles="true" Condition="Exists('$(_CustomTswDll)') And (Exists('$(TargetDir)tsw.dll') Or '$(RuntimeIdentifier)' == 'win-x64')" />
  </Target>

  <Target Name="OverrideNativeLibtorrent12OnPublish" AfterTargets="_HandleFileConflictsForPublish" BeforeTargets="_ComputeFilesToBundle">
    <PropertyGroup>
      <_CustomTswDll>$(MSBuildThisFileDirectory)..\..\native\win-x64\tsw.dll</_CustomTswDll>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(_CustomTswDll)')">
      <!-- Replace TorrentSharp.Wrap.Native's tsw.dll inside ResolvedFileToPublish BEFORE single-file bundling -->
      <_NugetTsw Include="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'tsw.dll'" />
      <ResolvedFileToPublish Remove="@(_NugetTsw)" />
      <ResolvedFileToPublish Include="$(_CustomTswDll)">
        <RelativePath>tsw.dll</RelativePath>
        <DestinationSubPath>tsw.dll</DestinationSubPath>
        <AssetType>native</AssetType>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
