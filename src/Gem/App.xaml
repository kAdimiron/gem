<Application x:Class="Gem.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:Gem.Converters"
             xmlns:helpers="clr-namespace:Gem.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Value Converters -->
            <converters:BytesToStringConverter x:Key="BytesConverter" />
            <converters:SpeedToStringConverter x:Key="SpeedConverter" />
            <converters:EtaToStringConverter x:Key="EtaConverter" />
            <converters:StatusKindToBrushConverter x:Key="StatusBrushConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibility" />

            <!-- Windows 11 Store Filter Pill Style -->
            <Style x:Key="FilterPillRadioStyle" TargetType="RadioButton">
                <Setter Property="helpers:FluentMotion.IsEnabled" Value="True" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="PillBorder"
                                    CornerRadius="16"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                    <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
