<ui:FluentWindow x:Class="Gem.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:Gem.Controls"
                 xmlns:loc="clr-namespace:Gem.Localization"
                 xmlns:views="clr-namespace:Gem.Views"
                 mc:Ignorable="d"
                 Title="{Binding AppWindowTitle}"
                 Icon="pack://application:,,,/Assets/Gem.ico"
                 Width="1240"
                 Height="780"
                 MinWidth="960"
                 MinHeight="620"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 AllowDrop="True"
                 DragEnter="Window_DragEnter"
                 DragLeave="Window_DragLeave"
                 Drop="Window_Drop">
    <Grid>
        <Grid x:Name="RootContentGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <!-- Custom Windows 11 Microsoft Store-style TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     Height="48"
                     Padding="0"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"
                     ShowMaximize="True"
                     ShowMinimize="True"
                     ShowClose="True">
            <!-- Left Brand (Width balanced with right caption buttons + theme button) -->
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal"
                            MinWidth="178"
                            Margin="14,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/Gem.png"
                           Width="12"
                           Height="12"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <Run Text="Gem"
                             FontSize="13.5"
                             FontWeight="SemiBold" />
                        <Run Text=" "
                             FontSize="11.5" />
                        <Run Text="{Binding CurrentVersionText, Mode=OneWay}"
                             FontSize="11.5"
                             FontWeight="Normal"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </TextBlock>
                </StackPanel>
            </ui:TitleBar.Header>

            <!-- Centered Store-style Search / Magnet Bar -->
            <ui:TitleBar.CenterContent>
                <ui:TextBox Width="440"
                            Height="32"
                            FontSize="12.5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            PlaceholderText="{loc:Tr SearchPlaceholder}"
                            Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                            Icon="{ui:SymbolIcon Search24}">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SubmitSearchOrMagnetCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
            </ui:TitleBar.CenterContent>

            <!-- Right Theme Switcher (Sun in dark mode, Moon in light mode) -->
            <ui:TitleBar.TrailingContent>
                <Grid Width="48" VerticalAlignment="Center">
                    <ui:Button x:Name="ThemeToggleButton"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               ToolTip="{Binding ThemeToggleTooltip}"
                               Height="32"
                               Width="34"
                               Padding="0"
                               Appearance="Transparent"
                               WindowChrome.IsHitTestVisibleInChrome="True"
                               Command="{Binding ToggleThemeCommand}">
                        <ui:SymbolIcon x:Name="ThemeIcon"
                                       Symbol="{Binding ThemeToggleIcon}"
                                       FontSize="17"
                                       RenderTransformOrigin="0.5,0.5">
                            <ui:SymbolIcon.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform x:Name="ThemeIconRotate" Angle="0" />
                                    <ScaleTransform x:Name="ThemeIconScale" ScaleX="1" ScaleY="1" />
                                </TransformGroup>
                            </ui:SymbolIcon.RenderTransform>
                        </ui:SymbolIcon>
                    </ui:Button>
                </Grid>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- Body: Microsoft Store Left Rail + Rounded Elevated Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="78" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Store-style Left Navigation Rail -->
            <controls:StoreNavRail Grid.Column="0"
                                   TopItems="{Binding TopNavItems}"
                                   BottomItems="{Binding BottomNavItems}"
                                   SelectCommand="{Binding NavigateToCommand}" />

            <!-- Elevated Content Container (CornerRadius top-left like Microsoft Store) -->
            <Border Grid.Column="1"
                    CornerRadius="10,0,0,0"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Non-intrusive GitHub Update Notification Strip -->
                    <Border Grid.Row="0"
                            Margin="24,14,24,0"
                            Padding="14,10"
                            CornerRadius="8"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                            BorderThickness="1"
                            Visibility="{Binding IsUpdateBannerVisible, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowDownload24"
                                               FontSize="18"
                                               Margin="0,0,10,0"
                                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                <TextBlock VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                    <Run Text="{loc:Tr UpdateBannerAvailablePrefix}" />
                                    <Run Text="{Binding AvailableUpdate.TagName, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ui:Button Content="{loc:Tr UpdateBannerUpdateButton}"
                                           Appearance="Primary"
                                           Height="28"
                                           Padding="12,0"
                                           FontSize="12"
                                           Margin="0,0,6,0"
                                           Command="{Binding DownloadAndInstallUpdateCommand}" />
                                <ui:Button Content="{loc:Tr UpdateBannerDetailsButton}"
                                           Appearance="Secondary"
                                           Height="28"
                                           Padding="10,0"
                                           FontSize="12"
                                           Margin="0,0,6,0"
                                           Command="{Binding OpenUpdatesSettingsCommand}" />
                                <ui:Button Icon="{ui:SymbolIcon Dismiss24}"
                                           Appearance="Transparent"
                                           Height="28"
                                           Width="28"
                                           Padding="0"
                                           ToolTip="{loc:Tr UpdateBannerDismissTooltip}"
                                           Command="{Binding DismissUpdateBannerCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Active Section Views -->
                    <Grid Grid.Row="1">
                        <views:HomeView Visibility="{Binding IsHomeView, Converter={StaticResource BoolToVisibility}}" />
                        <views:TorrentsView Visibility="{Binding IsTorrentsView, Converter={StaticResource BoolToVisibility}}" />
                        <views:SettingsView Visibility="{Binding IsSettingsView, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Drag & Drop Overlay -->
        <Border x:Name="DragDropOverlay"
                Grid.Row="0"
                Grid.RowSpan="2"
                Background="#B0000000"
                Visibility="Collapsed">
            <Border Width="420"
                    Height="210"
                    CornerRadius="12"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                    BorderThickness="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="CloudArrowDown24"
                                   FontSize="48"
                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                   HorizontalAlignment="Center" />
                    <TextBlock Text="{loc:Tr DragDropTitle}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,12,0,4"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{loc:Tr DragDropSubtitle}"
                               FontSize="12.5"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Border>

        <!-- Modal: Add Magnet Link -->
        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Background="#88000000"
                Visibility="{Binding IsAddMagnetModalOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="520"
                    CornerRadius="10"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <ui:SymbolIcon Symbol="Link24" FontSize="22" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="{loc:Tr MagnetModalTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>

                    <TextBlock Text="{loc:Tr MagnetModalUriLabel}" FontSize="12.5" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox Text="{Binding MagnetInputText, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{loc:Tr MagnetModalUriPlaceholder}"
                                Margin="0,0,0,14" />

                    <TextBlock Text="{loc:Tr MagnetModalSavePathLabel}" FontSize="12.5" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0"
                                    Text="{Binding MagnetSavePath, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,0,8,0" />
                        <ui:Button Grid.Column="1"
                                   Content="{loc:Tr CommonBrowse}"
                                   Command="{Binding BrowseMagnetSavePathCommand}" />
                    </Grid>

                    <CheckBox Content="{loc:Tr MagnetModalAutoStart}"
                              IsChecked="{Binding MagnetStartImmediately}"
                              Margin="0,0,0,18" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="{loc:Tr CommonCancel}"
                                   Appearance="Secondary"
                                   Margin="0,0,10,0"
                                   Padding="18,6"
                                   Command="{Binding CloseAddMagnetModalCommand}" />
                        <ui:Button Content="{loc:Tr CommonAdd}"
                                   Appearance="Primary"
                                   Padding="22,6"
                                   Command="{Binding ConfirmAddMagnetCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Modal: Create Torrent Release -->
        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Background="#88000000"
                Visibility="{Binding IsCreateTorrentModalOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="560"
                    CornerRadius="10"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <ui:SymbolIcon Symbol="DocumentAdd24" FontSize="22" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="{loc:Tr CreateModalTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>

                    <TextBlock Text="{loc:Tr CreateModalSourceLabel}" FontSize="12.5" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0"
                                    IsEnabled="{Binding CanEditCreateTorrentFields}"
                                    Text="{Binding CreateSourcePath, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{loc:Tr CreateModalSourcePlaceholder}"
                                    Margin="0,0,8,0" />
                        <ui:Button Grid.Column="1"
                                   Content="{loc:Tr CreateModalFileButton}"
                                   IsEnabled="{Binding CanEditCreateTorrentFields}"
                                   Margin="0,0,6,0"
                                   Command="{Binding BrowseCreateSourceFileCommand}" />
                        <ui:Button Grid.Column="2"
                                   Content="{loc:Tr CreateModalFolderButton}"
                                   IsEnabled="{Binding CanEditCreateTorrentFields}"
                                   Command="{Binding BrowseCreateSourceFolderCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding CreateSourceSummary}"
                               FontSize="12"
                               Margin="0,0,0,12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:Tr CreateModalPieceSizeLabel}" FontSize="12.5" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ComboBox IsEnabled="{Binding CanEditCreateTorrentFields}"
                                      ItemsSource="{Binding CreatePieceSizeOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedIndex="{Binding CreateSelectedPieceSizeIndex, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:Tr CreateModalCommentLabel}" FontSize="12.5" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBox IsEnabled="{Binding CanEditCreateTorrentFields}"
                                        Text="{Binding CreateComment, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="{loc:Tr CreateModalCommentPlaceholder}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{loc:Tr CreateModalTrackersLabel}" FontSize="12.5" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox Height="86"
                                AcceptsReturn="True"
                                VerticalContentAlignment="Top"
                                VerticalScrollBarVisibility="Auto"
                                IsEnabled="{Binding CanEditCreateTorrentFields}"
                                Text="{Binding CreateTrackersText, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="udp://tracker.opentrackr.org:1337/announce"
                                Margin="0,0,0,12" />

                    <CheckBox Content="{loc:Tr CreateModalPrivateCheck}"
                              IsEnabled="{Binding CanEditCreateTorrentFields}"
                              IsChecked="{Binding CreateIsPrivate}"
                              Margin="0,0,0,6" />
                    <CheckBox Content="{loc:Tr CreateModalSeedCheck}"
                              IsEnabled="{Binding CanEditCreateTorrentFields}"
                              IsChecked="{Binding CreateStartSeeding}"
                              Margin="0,0,0,14" />

                    <StackPanel Visibility="{Binding IsCreatingTorrent, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,0,14">
                        <TextBlock FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="{loc:Tr CreateModalHashingProgress}" />
                            <Run Text="{Binding CreateTorrentProgress, StringFormat={}{0:F0}%, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding CreateTorrentProgress, Mode=OneWay}" Height="6" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="{loc:Tr CommonCancel}"
                                   Appearance="Secondary"
                                   Margin="0,0,10,0"
                                   Padding="18,6"
                                   Command="{Binding CloseCreateTorrentModalCommand}" />
                        <ui:Button Content="{loc:Tr CreateModalSubmitButton}"
                                   Appearance="Primary"
                                   IsEnabled="{Binding CanEditCreateTorrentFields}"
                                   Padding="22,6"
                                   Command="{Binding ConfirmCreateTorrentCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Modal: Confirm Remove Torrent -->
        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Background="#88000000"
                Visibility="{Binding IsRemoveModalOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="460"
                    CornerRadius="10"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:SymbolIcon Symbol="Delete24" FontSize="22" Foreground="#C42B1C" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding RemoveModalTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>

                    <TextBlock Text="{Binding RemoveModalSummary}"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <CheckBox Content="{loc:Tr RemoveModalDeleteFilesCheck}"
                              IsChecked="{Binding DeleteFilesOnRemove}"
                              Margin="0,0,0,18" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="{loc:Tr CommonCancel}"
                                   Appearance="Secondary"
                                   Margin="0,0,10,0"
                                   Padding="18,6"
                                   Command="{Binding CancelRemoveTorrentCommand}" />
                        <ui:Button Content="{loc:Tr CommonDelete}"
                                   Appearance="Danger"
                                   Padding="20,6"
                                   Command="{Binding ConfirmRemoveTorrentCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
        </Grid>

        <!-- Theme Wave Reveal Overlay -->
        <Image x:Name="ThemeTransitionOverlay"
               Stretch="None"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               SnapsToDevicePixels="True"
               IsHitTestVisible="False"
               Visibility="Collapsed"
               Panel.ZIndex="999" />

        <!-- Wave Front Ring -->
        <Path x:Name="ThemeWaveRingPath"
              IsHitTestVisible="False"
              Visibility="Collapsed"
              StrokeThickness="6"
              Panel.ZIndex="1000" />
    </Grid>
</ui:FluentWindow>
