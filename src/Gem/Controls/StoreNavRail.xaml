<UserControl x:Class="Gem.Controls.StoreNavRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:Gem.Models"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="78"
             Width="78">
    <UserControl.Resources>
        <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type models:NavRailItem}">
            <Button Margin="6,2"
                    Padding="0"
                    Height="58"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Cursor="Hand"
                    Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=SelectCommand}"
                    CommandParameter="{Binding Section}"
                    ToolTip="{Binding Title}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="Transparent"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="Transparent"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>

                            <Grid>
                                <!-- Animated Hover Overlay -->
                                <Border x:Name="HoverLayer"
                                        CornerRadius="6"
                                        Opacity="0"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}" />

                                <!-- Animated Selected Overlay -->
                                <Border x:Name="SelectedLayer"
                                        CornerRadius="6"
                                        Opacity="0"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1" />

                                <!-- Badge -->
                                <Border x:Name="BadgeBorder"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,5,8,0"
                                        MinWidth="16"
                                        Height="16"
                                        Padding="4,0"
                                        CornerRadius="8"
                                        Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                        Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding BadgeCount}"
                                               FontSize="9.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- Centered Icon + Label (Microsoft Store signature layout) -->
                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Margin="4,2">
                                    <Grid x:Name="NavIconContainer"
                                          HorizontalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="SelectedIconScale" ScaleX="1" ScaleY="1" />
                                                <RotateTransform x:Name="SelectedIconRotate" Angle="0" />
                                                <TranslateTransform x:Name="SelectedIconTranslate" Y="0" />
                                            </TransformGroup>
                                        </Grid.RenderTransform>
                                        <ui:SymbolIcon x:Name="NavIcon"
                                                       Symbol="{Binding Icon}"
                                                       FontSize="20"
                                                       HorizontalAlignment="Center"
                                                       RenderTransformOrigin="0.5,0.5"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <ui:SymbolIcon.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="IconScale" ScaleX="1" ScaleY="1" />
                                                    <TranslateTransform x:Name="IconTranslate" Y="0" />
                                                </TransformGroup>
                                            </ui:SymbolIcon.RenderTransform>
                                        </ui:SymbolIcon>
                                    </Grid>
                                    <TextBlock x:Name="NavLabel"
                                               Text="{Binding Title}"
                                               Margin="0,4,0,0"
                                               FontSize="10.5"
                                               FontWeight="Normal"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Hover Enter/Exit Animation -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavIcon" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter TargetName="NavLabel" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="IconScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.13"
                                                             Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="IconScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.13"
                                                             Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="IconTranslate"
                                                             Storyboard.TargetProperty="Y"
                                                             To="-1.5"
                                                             Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="IconScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="IconScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="IconTranslate"
                                                             Storyboard.TargetProperty="Y"
                                                             To="0"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- Tactile Press Animation -->
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.93"
                                                             Duration="0:0:0.07" />
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.93"
                                                             Duration="0:0:0.07" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1"
                                                             Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1"
                                                             Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- Selected State (icon-only, caption hidden, icon activation pop animation) -->
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="NavIcon" Property="Filled" Value="True" />
                                <Setter TargetName="NavIcon" Property="FontSize" Value="22" />
                                <Setter TargetName="NavIcon" Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                <Setter TargetName="NavLabel" Property="Visibility" Value="Collapsed" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectedLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.18" />
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SelectedIconScale"
                                                                           Storyboard.TargetProperty="ScaleX">
                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.82" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.13" Value="1.24">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.23" Value="0.95">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <CubicEase EasingMode="EaseInOut" />
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.34" Value="1">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SelectedIconScale"
                                                                           Storyboard.TargetProperty="ScaleY">
                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.82" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.13" Value="1.24">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.23" Value="0.95">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <CubicEase EasingMode="EaseInOut" />
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.34" Value="1">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SelectedIconTranslate"
                                                                           Storyboard.TargetProperty="Y">
                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-6" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.16" Value="1.5">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.30" Value="0">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SelectedIconRotate"
                                                                           Storyboard.TargetProperty="Angle">
                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.11" Value="-8">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="4">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <CubicEase EasingMode="EaseInOut" />
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.33" Value="0">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectedLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="SelectedIconScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1"
                                                             Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="SelectedIconScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1"
                                                             Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="SelectedIconTranslate"
                                                             Storyboard.TargetProperty="Y"
                                                             To="0"
                                                             Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="SelectedIconRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             To="0"
                                                             Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="RootRailGrid" Background="Transparent" Margin="0,6,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top navigation rail items -->
        <ItemsControl x:Name="TopItemsControl"
                      Grid.Row="0"
                      ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=TopItems}"
                      ItemTemplate="{StaticResource NavItemTemplate}" />

        <!-- Bottom pinned items (Library, Create, Settings) -->
        <StackPanel Grid.Row="1">
            <Border Height="1"
                    Margin="14,6,14,6"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <ItemsControl x:Name="BottomItemsControl"
                          ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=BottomItems}"
                          ItemTemplate="{StaticResource NavItemTemplate}" />
        </StackPanel>

        <!-- Shared sliding active left indicator pill -->
        <Border x:Name="SlidingIndicator"
                Grid.Row="0"
                Grid.RowSpan="2"
                Width="3"
                Height="24"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="7,0,0,0"
                CornerRadius="1.5"
                Opacity="0"
                IsHitTestVisible="False"
                RenderTransformOrigin="0.5,0.5"
                Background="{DynamicResource SystemAccentColorPrimaryBrush}">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="IndicatorScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="IndicatorTranslate" Y="0" />
                </TransformGroup>
            </Border.RenderTransform>
        </Border>
    </Grid>
</UserControl>
