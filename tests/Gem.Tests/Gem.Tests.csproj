<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Gem\Gem.csproj" />
  </ItemGroup>

  <Target Name="OverrideTestNativeLibtorrent12" AfterTargets="Build">
    <PropertyGroup>
      <_CustomTswDll>$(MSBuildThisFileDirectory)..\..\native\win-x64\tsw.dll</_CustomTswDll>
    </PropertyGroup>
    <MakeDir Directories="$(TargetDir)runtimes\win-x64\native" Condition="Exists('$(_CustomTswDll)')" />
    <Copy SourceFiles="$(_CustomTswDll)" DestinationFiles="$(TargetDir)runtimes\win-x64\native\tsw.dll" SkipUnchangedFiles="true" Condition="Exists('$(_CustomTswDll)')" />
  </Target>

</Project>